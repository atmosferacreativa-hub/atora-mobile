{
  "expo": {
    "name": "ATORA",
    "slug": "atora-mobile",
    "version": "0.2.0",
    "updates": {
      "url": "https://u.expo.dev/a3b6c6d0-c58c-4508-ac3b-25c6ea11dd62"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "atora",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#13233A"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atmosferacreativa.atora",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.atmosferacreativa.atora",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13233A"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "",
      "eas": {
        "projectId": "a3b6c6d0-c58c-4508-ac3b-25c6ea11dd62"
      }
    },
    "owner": "atmosfera-creativa"
  }
}
